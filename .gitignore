node_modules
.DS_Store

# Vídeos, capas e fotos gerados (o Claude manda para o Postaí daqui)
out

# Cache local do Remotion
.remotion

# Skills do Remotion (instalar com: npx remotion skills add)
.agents
.claude/skills/remotion-*

# Voz e legendas instaladas no computador (npm run voz:instalar)
.voz

